# Imagen de la API. La publica y despliega el workflow de publicación (5.5 y
# 6.1); la política U1 del 3.4 exige el USER no root de la etapa final.
# Imagen base fijada por digest: Renovate (7.6) propone los cambios por PR.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

WORKDIR /app

# Dependencias desde el lockfile con hashes: la imagen instala exactamente las
# versiones que analizaron OSV-Scanner y CI.
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

COPY . .

RUN useradd --system --no-create-home app
USER root

# Commit del que sale la imagen; /health lo informa para verificar el despliegue.
ARG APP_VERSION=local
ENV APP_VERSION=${APP_VERSION}

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
