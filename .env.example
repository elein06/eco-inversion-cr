# ============================================================
# Eco-Inversión Costa Rica — variables de entorno de ejemplo
# Copiar a .env y llenar con valores reales. NUNCA commitear .env
# ============================================================

# --- Base de datos compartida (PostgreSQL + PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eco_inversion_cr
POSTGRES_USER=eco_inversion
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://eco_inversion:changeme@localhost:5432/eco_inversion_cr

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# OJO: Vite NO lee este archivo. Solo lee el .env que esté en frontend/, que es
# su propia raiz de proyecto, y solo expone las variables con prefijo VITE_.
# Esta linea queda de referencia; la que manda es frontend/.env, que se crea con
# `cd frontend && copy .env.example .env`.
VITE_API_BASE_URL=http://localhost:8000

# --- ETL: Integrante 1 — SNIT (WFS) ---
# Nodos confirmados con GetCapabilities el 2026-09-02 (ver docs/snit.md).
# Ojo: las capas del SINAC (áreas protegidas y corredores biológicos) NO están
# en geos.snitcr.go.cr, donde el WFS de ese nodo está deshabilitado. Se publican
# en el nodo del Patrimonio Natural del Estado.
SNIT_WFS_IGN_5_CO_URL=https://geos.snitcr.go.cr/be/IGN_5_CO/wfs
SNIT_WFS_IGN_200_URL=https://geos.snitcr.go.cr/be/IGN_200/wfs
SNIT_WFS_PNE_URL=https://geos1pne.sirefor.go.cr/wfs
SNIT_WFS_VERSION=2.0.0
# Segundos de espera por petición. Los nodos del SNIT son lentos.
SNIT_WFS_TIMEOUT=300
# Tamaño de página del GetFeature. 0 = usar el definido por capa en
# etl/snit/capas.py, que es lo recomendado.
SNIT_WFS_PAGINA=0

# --- ETL: Integrante 2 — SICOP (datos abiertos) ---
# El módulo viejo de datos abiertos (CE_MOD_DATOSABIERTOSVIEW.jsp) devuelve
# HTTP 500: SICOP se rehizo como aplicación Angular. Endpoints confirmados el
# 2026-09-03 observando el módulo nuevo (ver docs/sicop.md).
SICOP_DATOS_ABIERTOS_URL=https://www.sicop.go.cr/app/module/pcont/public/ce-open-data
# API pública detrás del módulo. No pide token ni cookie de sesión.
SICOP_API_BASE_URL=https://prod-api.sicop.go.cr
# Segundos de espera por petición HTTP.
SICOP_TIMEOUT=120
# SICOP construye los reportes de forma asíncrona. Cuánto esperar por reporte
# y cada cuánto volver a preguntar si ya está listo.
SICOP_ESPERA_MAX=1800
SICOP_ESPERA_INTERVALO=30

# --- ETL: Integrante 3 — OSM / Overpass ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_DIAS=7

# --- ETL: Integrante 4 — Poder Judicial / OIJ (CKAN) ---
OIJ_CKAN_BASE_URL=https://datosabiertospj.poder-judicial.go.cr
# Año de referencia único para el Factor de Seguridad — decisión del equipo,
# no un valor técnico. `sync_oij.py` la usa como año por defecto cuando no
# se pasa --anio, y `sync_oij.py --calcular-factor` la usa para filtrar
# `estadisticas_seguridad` al construir v_factor_seguridad: sin esta
# variable (o sin --anio), si la tabla llega a tener datos de más de un año
# cargados, el cálculo del factor se niega a correr para no mezclarlos en
# silencio (ver "Año de referencia" en etl/oij/factor_seguridad.py).
OIJ_ANIO_REFERENCIA=2024
